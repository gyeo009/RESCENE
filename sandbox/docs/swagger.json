{
    "swagger": "2.0",
    "info": {
        "description": "Docker 샌드박스 컨테이너 관리를 위한 확장 가능한 API 서버입니다.",
        "title": "Sandbox API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/sandbox": {
            "post": {
                "description": "지정된 이미지를 활용해 격리된 실행 환경 컨테이너를 올리고, 호스트에 마운트할 작업 폴더를 생성합니다.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sandbox"
                ],
                "summary": "샌드박스 환경 생성",
                "parameters": [
                    {
                        "description": "샌드박스 이미지/시나리오 정보",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.SandboxCreateRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.SandboxCreateResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/sandbox/{id}": {
            "delete": {
                "description": "샌드박스 컨테이너 작동을 멈추고 삭제한 뒤, 호스트의 작업 디렉토리를 비웁니다.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sandbox"
                ],
                "summary": "샌드박스 완전 삭제 및 정리",
                "parameters": [
                    {
                        "type": "string",
                        "description": "샌드박스 식별 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.SuccessResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/sandbox/{id}/files": {
            "get": {
                "description": "사용자가 샌드박스 내부에서 작성/수정한 파일 전체 경로들을 나열합니다.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "files"
                ],
                "summary": "샌드박스 내 파일 목록 조회",
                "parameters": [
                    {
                        "type": "string",
                        "description": "샌드박스 식별 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.FileListResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    }
                }
            },
            "put": {
                "description": "샌드박스 작업 디렉토리에 임의의 파일을 생성하거나 파일의 내용을 변경합니다.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "files"
                ],
                "summary": "파일 생성 및 저장",
                "parameters": [
                    {
                        "type": "string",
                        "description": "샌드박스 식별 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "작성할 파일 경로 및 본문 텍스트",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.FileWriteRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.SuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "description": "샌드박스 작업 폴더 내부의 특정 파일을 삭제합니다.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "files"
                ],
                "summary": "파일 삭제",
                "parameters": [
                    {
                        "type": "string",
                        "description": "샌드박스 식별 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "삭제하려는 파일의 상대경로",
                        "name": "filename",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.SuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/sandbox/{id}/files/content": {
            "get": {
                "description": "특정 샌드박스의 개별 파일 내용을 텍스트로 읽어옵니다.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "files"
                ],
                "summary": "파일 내용 상세 조회",
                "parameters": [
                    {
                        "type": "string",
                        "description": "샌드박스 식별 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "조회하려는 파일의 상대경로",
                        "name": "filename",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.FileContentResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/sandbox/{id}/logs": {
            "get": {
                "description": "샌드박스 컨테이너의 표준 출력 및 에러 출력을 조회합니다.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sandbox"
                ],
                "summary": "샌드박스 컨테이너 로그 조회",
                "parameters": [
                    {
                        "type": "string",
                        "description": "샌드박스 식별 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.SandboxRunResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/sandbox/{id}/run": {
            "post": {
                "description": "구동 중인 샌드박스 컨테이너 내부에서 동기로 명령을 Exec하여 그 출력을 가져옵니다.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sandbox"
                ],
                "summary": "샌드박스 내 명령어 실행",
                "parameters": [
                    {
                        "type": "string",
                        "description": "샌드박스 식별 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "실행 명령 정보",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.SandboxRunRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.SandboxRunResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/sandbox/{id}/stop": {
            "post": {
                "description": "작동 중인 샌드박스 컨테이너를 중지 상태로 변경합니다.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sandbox"
                ],
                "summary": "샌드박스 컨테이너 중지",
                "parameters": [
                    {
                        "type": "string",
                        "description": "샌드박스 식별 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.SuccessResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.FileWriteRequest": {
            "type": "object",
            "required": [
                "content",
                "filename"
            ],
            "properties": {
                "content": {
                    "description": "파일에 기록할 텍스트 내용",
                    "type": "string",
                    "example": "print('hello')"
                },
                "filename": {
                    "description": "생성/수정할 파일명 및 상대 경로",
                    "type": "string",
                    "example": "main.py"
                }
            }
        },
        "dto.SandboxCreateRequest": {
            "type": "object",
            "required": [
                "scenario"
            ],
            "properties": {
                "scenario": {
                    "description": "실행할 이미지/시나리오명",
                    "type": "string",
                    "example": "python:3.10-alpine"
                }
            }
        },
        "dto.SandboxRunRequest": {
            "type": "object",
            "required": [
                "cmd"
            ],
            "properties": {
                "cmd": {
                    "description": "실행할 명령어 및 인자 리스트",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "python",
                        "main.py"
                    ]
                }
            }
        },
        "response.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "description": "에러 상세 메시지",
                    "type": "string",
                    "example": "invalid request parameters"
                }
            }
        },
        "response.FileContentResponse": {
            "type": "object",
            "properties": {
                "content": {
                    "description": "파일 텍스트 콘텐츠",
                    "type": "string",
                    "example": "print(1)"
                },
                "filename": {
                    "description": "파일명",
                    "type": "string",
                    "example": "main.py"
                }
            }
        },
        "response.FileListResponse": {
            "type": "object",
            "properties": {
                "files": {
                    "description": "작업 공간 안의 모든 파일명 리스트",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "response.SandboxCreateResponse": {
            "type": "object",
            "properties": {
                "container_id": {
                    "description": "구동된 런타임 컨테이너 식별자 ID",
                    "type": "string",
                    "example": "container-uuid-123"
                },
                "sandbox_id": {
                    "description": "생성된 고유 샌드박스(작업 공간) 식별자",
                    "type": "string",
                    "example": "sandbox-uuid-123"
                }
            }
        },
        "response.SandboxRunResponse": {
            "type": "object",
            "properties": {
                "output": {
                    "description": "명령어 실행 후 표준출력/에러 결과",
                    "type": "string",
                    "example": "hello world\n"
                }
            }
        },
        "response.SuccessResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "description": "성공 여부 상태 (\"success\")",
                    "type": "string",
                    "example": "success"
                }
            }
        }
    }
}